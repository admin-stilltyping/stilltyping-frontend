{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/webhooks/instagram", "destination": "https://stilltyping-backend.vercel.app/webhooks/instagram" },
    { "source": "/api/:path*", "destination": "https://stilltyping-backend.vercel.app/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://stilltyping-backend.vercel.app/auth/:path*" },
    { "source": "/admin/:path*", "destination": "https://stilltyping-backend.vercel.app/admin/:path*" },
    { "source": "/web/:path*", "destination": "https://stilltyping-backend.vercel.app/web/:path*" },
    { "source": "/health", "destination": "https://stilltyping-backend.vercel.app/health" },
    { "source": "/module-catalog", "destination": "https://stilltyping-backend.vercel.app/module-catalog" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    }
  ]
}
